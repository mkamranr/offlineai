# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# OfflineAI runtime data — never commit bundles or caches.
# Note offlineai.lock is NOT ignored: it pins what a rebuild resolves to
# and belongs in version control.
*.offlineai
# Lock files under examples/ are artifacts of running the test suite,
# not a recommendation: your own offlineai.lock SHOULD be committed.
examples/*/offlineai.lock
.offlineai/
/offlineai-data/
/out/

# Signing keys must never be committed
*.pem
*.key
!tests/fixtures/**/*.key

# OS
.DS_Store
